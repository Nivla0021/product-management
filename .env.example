# Copy to .env.local; never commit the real values.
# Neon injects DATABASE_URL into deployed Functions. For local SQL tools only:
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
ADMIN_PASSWORD=replace-with-a-long-random-password
# Origins have no path or trailing slash. Separate multiple origins with commas.
ALLOWED_ORIGINS=https://YOUR-USERNAME.github.io,http://localhost:4173
